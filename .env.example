# 텔레그램 봇 설정
# BotFather를 통해 발급받은 텔레그램 봇 토큰
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 화이트리스트 사용자 ID (쉼표로 구분)
# 텔레그램에서 /start를 보내면 봇이 user_id를 반환합니다
TELEGRAM_WHITELIST_USER_IDS=123456789,987654321

# Anthropic Claude API 키
# Anthropic Console에서 발급받은 API 키
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# GitHub Personal Access Token
# 필요한 권한: repo, workflow
GITHUB_TOKEN=your_github_personal_access_token_here

# 작업 타임아웃 (분 단위, 기본값: 30)
# TASK_TIMEOUT_MINUTES=30

# 로그 토큰 제한 (기본값: 2000)
# LOG_TOKEN_LIMIT=2000
